# ==============================================================================
# Global Gitignore - AI Travel Agent & Collaborative Planner
# ==============================================================================

# Core Local Configuration / Secrets
.env
.env.local
.env.production
.env.development
.env.staging
.demoenv

# Local Databases (SQLite and other locks)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Python Virtual Environments
.venv/
venv/
env/
ENV/
dist/
build/
*.egg-info/
__pycache__/
*.pyc
*.pyo
*.pyd

# Node.js (Frontend node modules & Vite server logs)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
vite.err.log
vite.out.log
.vite/
.eslintcache

# Logs & Temporary Files
*.log
uvicorn.err.log
uvicorn.out.log
.cache
.pytest_cache/
.coverage
htmlcov/

# Editor / IDE settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Optional: Keep interview preparation files local if desired
# Ignore documentation / interview preparation guides
docs/