# ==============================================================================
# AI Travel Agent & Collaborative Planner - Environment Variables Template
# ==============================================================================
# Rename this file to `.env` and fill in your actual credentials.
# Do NOT commit the active `.env` file to version control.

# Google Places API Credentials (for maps and locations searches)
GOOGLE_API_KEY=your_google_places_api_key_here

# Google Gemini LLM API Credentials (for AI itinerary generation and chatbot)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Amadeus API Credentials (for flight searches)
AMADEUS_API_KEY=your_amadeus_client_id_here
AMADEUS_API_SECRET=your_amadeus_client_secret_here

# RapidAPI IRCTC Credentials (for train schedule details - optional)
TRAIN_API_KEY=your_rapidapi_train_key_here
TRAIN_API_URL=https://irctc-insight.p.rapidapi.com

# Database Configurations
# SQLite default: sqlite:///./travel_planner.db
# PostgreSQL example: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://username:password@hostname:port/database_name
# Email Invitations SMTP Configurations
# (Required for sending collaborative trip signup verification codes)
FROM_EMAIL=your_smtp_gmail_here@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here@gmail.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_USE_TLS=true

# JWT Token Session Config
# (Should be a strong random 256-bit hexadecimal string in production)
SECRET_KEY=your-super-secret-jwt-key-change-in-production-12345

# Optional Settings
SQL_ECHO=false
FRONTEND_BASE_URL=http://localhost:5173
